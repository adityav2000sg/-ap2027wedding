# ── Database ────────────────────────────────────────────────────────────────
# Local:      postgresql://USER@localhost:5432/ap_wedding_os?schema=public
# Railway:    provided automatically as ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://USER@localhost:5432/ap_wedding_os?schema=public"

# ── Auth ────────────────────────────────────────────────────────────────────
# Signs the session cookie and salts OTP hashes. Generate with:
#   openssl rand -base64 32
# Changing this signs everybody out.
AUTH_SECRET="change-me-to-a-long-random-string"

# ── File storage ────────────────────────────────────────────────────────────
# Absolute path to a PERSISTENT directory. On Railway, create a Volume and
# mount it at /app/storage, then set this to that path.
# Leave unset locally — defaults to ./storage.
# STORAGE_DIR="/app/storage"

# ── Email (Resend) — sign-in codes ──────────────────────────────────────────
# Use a Resend API key and a sender address on a domain verified in Resend.
# Example: Avantika & Prateek <login@yourdomain.com>
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Avantika & Prateek <login@yourdomain.com>"

# ── AI Planner (optional) ───────────────────────────────────────────────────
# Everything else works without this; the AI page shows a clear notice.
QWEN_API_KEY=""
QWEN_MODEL="qwen-max"
QWEN_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
